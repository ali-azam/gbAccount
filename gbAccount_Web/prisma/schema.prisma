generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model AccCategory {
  CategoryID   Int        @id(map: "PK_AccCategory") @default(autoincrement())
  CategoryName String?    @db.NVarChar(50)
  CreateUser   String     @default("suser_sname()", map: "DF_AccCategory_CreateUser") @db.VarChar(35)
  CreateDate   DateTime   @default(now(), map: "DF_AccCategory_CreateDate") @db.SmallDateTime
  AccChart     AccChart[]
}

model AccChart {
  AccID         Int          @id(map: "PK_AccChart") @default(autoincrement())
  AccCode       String       @db.VarChar(50)
  AccName       String?      @db.VarChar(100)
  AccLevel      Int?
  FirstLevel    String?      @db.VarChar(50)
  SecondLevel   String?      @db.VarChar(50)
  ThirdLevel    String?      @db.VarChar(50)
  FourthLevel   String?      @db.VarChar(50)
  FifthLevel    String?      @db.VarChar(50)
  CategoryID    Int?
  OfficeLevel   Int?
  IsTransaction Boolean?
  Nature        String?      @db.VarChar(2)
  ModuleID      Int?
  NoteID        Int?
  OrgID         Int          @default(1, map: "DF_AccChart_OrgID")
  IsActive      Boolean?
  InActiveDate  DateTime?    @db.SmallDateTime
  CreateUser    String       @default("suser_sname()", map: "DF_AccChart_CreateUser") @db.VarChar(35)
  CreateDate    DateTime     @default(now(), map: "DF_AccChart_CreateDate") @db.SmallDateTime
  BankAccountNo String?      @db.NVarChar(50)
  Address       String?      @db.NVarChar(150)
  AccCategory   AccCategory? @relation(fields: [CategoryID], references: [CategoryID], onDelete: NoAction, onUpdate: NoAction, map: "FK_AccChart_AccCategory")
  Organization  Organization @relation(fields: [OrgID], references: [OrgID], onUpdate: NoAction, map: "FK_AccChart_Organization")
}

model Organization {
  OrgID            Int           @id(map: "PK_Organization")
  OrganizationCode String?       @db.VarChar(20)
  OrganizationName String?       @db.VarChar(50)
  IsActive         Boolean       @default(true, map: "DF_Organization_IsActive")
  InActiveDate     DateTime?     @db.SmallDateTime
  CreateUser       String        @default("suser_sname()", map: "DF_Organization_CreateUser") @db.VarChar(35)
  CreateDate       DateTime      @default(now(), map: "DF_Organization_CreateDate") @db.SmallDateTime
  OrgAddress       String?       @default("ABC", map: "DF__Organizat__OrgAd__702B5F39") @db.VarChar(150)
  OrgLOGO          Bytes?
  MemberAge        Int?
  LoanAge          Int?
  GuarantorAge     Int?          @default(0, map: "DF__Organizat__Guara__43CE8565")
  AccChart         AccChart[]
  GeoLocation      GeoLocation[]
  Office           Office[]
}

model AccLastVoucher {
  LastVoucherID Int    @id(map: "PK_AccLastVoucher") @default(autoincrement())
  OfficeID      Int
  VoucherNo     String @db.VarChar(50)
}

model AccTrxDetail {
  TrxDetailsID BigInt    @id(map: "PK_AccTrxDetail") @default(autoincrement())
  TrxMasterID  BigInt
  AccID        Int?
  Credit       Decimal?  @db.Decimal(18, 2)
  Debit        Decimal?  @db.Decimal(18, 2)
  Narration    String?   @db.NVarChar(200)
  IsActive     Boolean?
  InActiveDate DateTime? @db.SmallDateTime
  CreateUser   String    @db.VarChar(35)
  CreateDate   DateTime  @db.SmallDateTime
}

model AccTrxMaster {
  TrxMasterID        BigInt    @id(map: "PK_AccTrxMaster") @default(autoincrement())
  OfficeID           Int
  TrxDate            DateTime  @db.Date
  VoucherNo          String    @db.VarChar(50)
  VoucherDesc        String?   @db.VarChar(200)
  VoucherType        String?   @db.VarChar(3)
  Reference          String?   @db.VarChar(125)
  IsPosted           Boolean?
  IsYearlyClosing    Boolean?
  IsAutoVoucher      Boolean?
  IsRectify          Boolean?
  OrgID              Int
  IsActive           Boolean?
  InActiveDate       DateTime? @db.SmallDateTime
  CreateUser         String    @db.VarChar(35)
  CreateDate         DateTime  @db.SmallDateTime
  IsReconcileVoucher Boolean?
}

model AccReconcile {
  AccReconcileID       BigInt    @id(map: "PK__AccRecon__D594193A12D7AE23") @default(autoincrement())
  TrxMasterID          BigInt
  TrxDate              DateTime  @db.Date
  SenderOfficeId       Int?
  ReceiverOfficeId     Int?
  ReffNo               String?   @db.VarChar(50)
  Purpose              String?   @db.VarChar(100)
  Credit               Decimal?  @db.Decimal(18, 2)
  Debit                Decimal?  @db.Decimal(18, 2)
  IsReconcile          Boolean?
  OrgID                Int?
  IsActive             Boolean?
  InActiveDate         DateTime? @db.Date
  CreateUser           String    @db.VarChar(35)
  CreateDate           DateTime  @db.Date
  Receiver_TrxMasterID BigInt?
  HO_TrxMasterID       BigInt?
}

model GeoLocation {
  GeoLocationID Int           @id(map: "PK_GeoLocation")
  LocationName  String        @db.VarChar(65)
  LocationLevel Int           @db.TinyInt
  FirstLevel    String        @db.VarChar(10)
  SecondLevel   String?       @db.VarChar(10)
  ThirdLevel    String?       @db.VarChar(10)
  FourthLevel   String?       @db.VarChar(10)
  FifthLevel    String?       @db.VarChar(10)
  OrgID         Int?
  IsActive      Boolean?
  InActiveDate  DateTime?     @db.SmallDateTime
  CreateUser    String        @default("suser_sname()", map: "DF_GeoLocation_CreateUser") @db.VarChar(35)
  CreateDate    DateTime      @default(now(), map: "DF_GeoLocation_RecordDate") @db.SmallDateTime
  Organization  Organization? @relation(fields: [OrgID], references: [OrgID], onDelete: NoAction, onUpdate: NoAction, map: "FK_GeoLocation_Organization")
  Office        Office[]
}

model Office {
  OfficeID           Int          @id(map: "PK_Office") @default(autoincrement())
  OfficeCode         String       @db.VarChar(10)
  OfficeName         String       @db.NVarChar(40)
  OfficeLevel        Int          @db.TinyInt
  FirstLevel         String       @db.VarChar(10)
  SecondLevel        String?      @db.VarChar(10)
  ThirdLevel         String?      @db.VarChar(10)
  FourthLevel        String?      @db.VarChar(10)
  OperationStartDate DateTime     @db.Date
  OfficeAddress      String?      @db.VarChar(155)
  PostCode           String?      @db.VarChar(10)
  GeoLocationID      Int?
  Email              String?      @db.VarChar(45)
  Phone              String?      @db.VarChar(35)
  bankasiaaccno      String?      @db.VarChar(35)
  PhonebKash         String?      @db.VarChar(30)
  OrgID              Int          @default(1, map: "DF_Office_OrgID")
  IsActive           Boolean      @default(true, map: "DF_Office_IsActive")
  InActiveDate       DateTime?    @db.SmallDateTime
  CreateUser         String       @default("suser_sname()", map: "DF_Office_CreateUser") @db.VarChar(35)
  CreateDate         DateTime     @default(now(), map: "DF_Office_CreateDate") @db.SmallDateTime
  InvestorID         Int?         @default(1, map: "DF__Office__Investor__033E33AD")
  UnionID            Int?
  IsProjectOffice    Boolean?
  ProjectOffice      String?      @db.VarChar(10)
  UnionCode          String?      @db.NVarChar(50)
  GeoLocation        GeoLocation? @relation(fields: [GeoLocationID], references: [GeoLocationID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Office_GeoLocation")
  Organization       Organization @relation(fields: [OrgID], references: [OrgID], onUpdate: NoAction, map: "FK_Office_Organization")
}
