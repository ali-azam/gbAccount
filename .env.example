# This file is optional. The UI defaults to http://localhost:5025, which matches
# the API's `http` launch profile, so no .env is needed for local development.
#
# Create a .env from this template only when the API runs somewhere else.
# Must be NEXT_PUBLIC_-prefixed: these fetches run in the browser, not on the
# Next.js server. Never commit .env.
NEXT_PUBLIC_API_BASE_URL="http://localhost:5025"

# Database credentials are not read here. The SQL Server connection string lives
# in GbAccount.Api/appsettings.Development.json — copy it from
# GbAccount.Api/appsettings.Development.json.example.
