# Copy to .env and fill in real values. Never commit .env.

# SQL Server connection used by src/lib/prisma.ts.
# Set DB_ENCRYPT=true and DB_TRUST_SERVER_CERT=false against a real server with a valid certificate.
DB_SERVER="localhost"
DB_PORT="1433"
DB_NAME="GbAccount"
DB_USERNAME=""
DB_PASSWORD=""
DB_ENCRYPT="false"
DB_TRUST_SERVER_CERT="true"

# Used only by the Prisma CLI (migrate, studio).
DATABASE_URL="sqlserver://localhost:1433;database=GbAccount;user=;password=;encrypt=false;trustServerCertificate=true"
